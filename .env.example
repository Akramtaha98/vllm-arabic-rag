# --- OPTION A: your own self-hosted vLLM server (no API key needed) ---
VLLM_API_URL=http://localhost:8000/v1/chat/completions
VLLM_METRICS_URL=http://localhost:8000/metrics
VLLM_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
# VLLM_API_KEY=

# --- OPTION B: NVIDIA NIM hosted endpoint (build.nvidia.com) ---
# Get a free API key at https://build.nvidia.com -> pick a model -> "Get API Key"
# VLLM_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
# VLLM_MODEL_NAME=meta/llama-3.3-70b-instruct
# VLLM_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NOTE: NIM is a *hosted* endpoint, so it has no /metrics — use "Fixed ratio"
# mode in the sidebar, not "Dynamic (vLLM load-aware)", when using Option B.

# Cross-encoder used for semantic sentence pruning
PRUNER_MODEL_NAME=BAAI/bge-reranker-v2-m3
